# ── Required ────────────────────────────────────────────────────────────────
# Your Gmail address — digest email is sent here
CANDIDATE_EMAIL=you@gmail.com

# RapidAPI key for Indeed search — free tier available
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/indeed12
RAPIDAPI_KEY=your_rapidapi_key_here

# Google OAuth credentials — download from Google Cloud Console
# Enable the Gmail API, then create an OAuth 2.0 Client ID (Desktop app)
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# ── Optional ────────────────────────────────────────────────────────────────
# Days filter for Dice results: ONE | THREE | SEVEN (default: SEVEN)
DICE_POSTED=SEVEN
