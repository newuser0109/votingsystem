# ── Required ────────────────────────────────────────────────────────────────
# Anthropic API key — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# RapidAPI key for Indeed job search — https://rapidapi.com/letscrape-6bRBa3QguO5/api/indeed12
RAPIDAPI_KEY=your_rapidapi_key_here

# Your email address (drafts will be addressed to you for review before sending)
CANDIDATE_EMAIL=you@example.com

# Your name (used in cover letters)
CANDIDATE_NAME=Your Full Name

# ── Optional ────────────────────────────────────────────────────────────────
# Minimum fit score to draft an application (0-100, default: 75)
MIN_FIT_SCORE=75

# Days after applying to schedule a follow-up calendar reminder (default: 5)
FOLLOW_UP_DAYS=5

# Max jobs to process per pipeline run (default: 20)
MAX_JOBS_PER_RUN=20

# Path to SQLite database (default: job_search.db in current directory)
DB_PATH=job_search.db

# Google OAuth credentials file — download from Google Cloud Console
# Enable Gmail API + Calendar API, then create OAuth 2.0 Client ID credentials
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
